---
import asciiArt from './ascii-art.txt?raw';

interface Props {
	size?: number;
}

const { size = 16 } = Astro.props;
---

<div class="ascii-art" style={`--ascii-size: ${size}px`}>
	<Fragment set:html={asciiArt} />
</div>

<style>
	.ascii-art {
		container-type: inline-size;
		width: 100%;
		max-width: 1600px;
		margin-right: auto;
		overflow: hidden;
		contain: layout style paint;
	}

	:global(pre.ascii) {
		--line-length: 220;
		--glyph-advance: 0.6;
		margin: 0;
		padding: 1.25em;
		font-family: var(--font-ascii-export-mono);
		font-size: min(
			var(--ascii-size),
			calc(100cqw / (var(--line-length) * var(--glyph-advance) + 2.5))
		);
		font-weight: 600;
		line-height: 1.188;
		white-space: pre;
		text-rendering: geometricPrecision;
		font-variant-ligatures: none;
	}
</style>